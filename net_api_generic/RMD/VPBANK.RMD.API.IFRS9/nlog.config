<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="c:\temp\nlog-internal.log">

    <!-- extensions -->
    <extensions>
        <add assembly="NLog.Web.AspNetCore"/>
        <add assembly="NLog.Targets.ElasticSearch"/>
    </extensions>

    <!-- define various log targets -->
    <variable name="logDirectory" value="${basedir}/logs" />

    <targets async="true">
        <!-- add your targets here See https://github.com/nlog/NLog/wiki/Targets for possible targets. See https://github.com/nlog/NLog/wiki/Layout-Renderers for the possible layout renderers. -->
        <!-- Write events to a file with the date in the filename. -->
        <target name="logfile" 
                xsi:type="File" 
                fileName="${basedir}/logs/audit.log"
                layout="${longdate} ${pad:padding=3:fixedLength=true:inner=${level:upperCase=true}}   - EventLogger - ${message} ${exception:format=tostring}" />
    </targets>

    <rules>
        <!-- add your logging rules here -->
        <!-- Write all events with minimal level of Debug (So Debug, Info, Warn, Error and Fatal, but not Trace)  to "f" -->
        <logger name="*" minlevel="Trace" writeTo="logfile" />
    </rules>
</nlog>